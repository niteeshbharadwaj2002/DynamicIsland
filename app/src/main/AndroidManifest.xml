<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <!-- Never granted by the install dialog. Android 15+ replaces the text of notifications it thinks are
         sensitive (and, on some ROMs, all of them) with "Sensitive notification content hidden" for every
         notification listener without this permission. Granted from Shizuku or adb (see ShizukuManager). -->
    <uses-permission
        android:name="android.permission.RECEIVE_SENSITIVE_NOTIFICATIONS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Brightness slider on the Utilities page: writing the screen brightness needs this special permission (granted in system settings). -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- A normal permission, granted at install. Lets the Clear cache utility stop background apps. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- A normal permission, granted at install. Lets the Timer utility start a countdown in the clock app without opening it. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Lets the app appear in "Do Not Disturb access": the mode idle widget reads which mode (Bedtime, Driving, ...) is on. Nothing is changed. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <!-- Lets the call card mute the mic and switch earpiece / speaker / Bluetooth for apps whose call
         notification has no such buttons. A normal permission, granted at install. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Restore-permissions alert (Rule_Book 7.1). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 15+ screen-recording callback, to add FLAG_SECURE while recorded (Rule_Book 8.2). -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_RECORDING" />

    <!-- ADB-granted only: hides status-bar clutter via icon_blacklist (Rule_Book 10.2). -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Privileged/system builds only: names the app using the camera / mic (Rule_Book 4.15, 4.16).
         Without it the privacy indicator falls back to camera availability and recording callbacks. -->
    <uses-permission
        android:name="android.permission.WATCH_APPOPS"
        tools:ignore="ProtectedPermissions" />

    <queries>
        <!-- Lets the Shizuku check see the Shizuku app (Android 11+ hides apps that are not listed here). -->
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="com.android.systemui" />
        <package android:name="com.libremobileos.freeform" />
        <!-- Lets a settings page (hotspot, Wi-Fi) be found by its intent so LMO Freeform can open it in a window. -->
        <package android:name="com.android.settings" />
        <!-- Lets the Timer utility find the clock app (to open it in a floating window when the timer cannot start directly). -->
        <intent>
            <action android:name="android.intent.action.SHOW_TIMERS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Lets the split-screen shortcut tell the home screen apart from an open app. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name=".SmartIslandApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.SmartIsland">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SmartIsland">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The island's own pickers (pinned apps, utilities) in a see-through window of their own: choosing never opens the app. -->
        <activity
            android:name=".ui.pickers.PickerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density|fontScale|layoutDirection|locale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SmartIsland.Picker" />

        <!-- Invisible: asks the keyguard to unlock before a gated island action runs (Rule_Book 8.3). -->
        <activity
            android:name=".ui.UnlockTrampolineActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".service.SmartIslandOverlayService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating Dynamic Island overlay"
                tools:targetApi="upsidedowncake" />
        </service>

        <service
            android:name=".service.SmartIslandNotificationListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <receiver
            android:name=".receiver.AutostartReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.USER_PRESENT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receiver.StopwatchActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".receiver.TimerActionReceiver"
            android:exported="false" />

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
